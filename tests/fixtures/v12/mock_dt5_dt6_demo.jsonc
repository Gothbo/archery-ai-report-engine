// ============================================================
// v1.2 接口文档 · mock 数据（开发授权 PM 侧定义格式，后续对接）
// 配套完整文件：dt5_拉力曲线_完整4101点.json（103KB，全量）
// 本文件为演示版：curve 只列关键特征点，结构与全量一致
// 口径：UTC 毫秒尾 Z · 雪花 ID 字符串 · 数值统计量用 number
// ============================================================

// ---- dataType=5 拉力曲线（1000Hz，事后聚合，拉力窗 -3600~+500ms）----
{
  "schemaVersion": "1.1",
  "messageId": "msg_1963169497552654_0001",   // 幂等去重键
  "sentAt": "2025-09-09T10:18:45.800Z",        // 发送时刻（可选）
  "dataType": 5,
  "data": {
    "releaseTime": "2025-09-09T10:18:44.620Z", // 离弦锚点（设备端力曲线拐点算得）
    "shotSeq": 1,
    "shotId": "1963169497552654336",           // 雪花 ID 字符串
    "unit": "kg",
    "sampleRateHz": 1000,                      // 1ms/点
    "curve": [                                  // 完整 4101 点见配套文件；此演示 12 个特征点
      { "t": -3600, "f": 0.0 },                // 起弓
      { "t": -3000, "f": 8.0 },                // 拉弓上升
      { "t": -2000, "f": 16.5 },
      { "t": -1000, "f": 21.0 },
      { "t": -490,  "f": 22.6 },               // 峰值·满弓段
      { "t": -180,  "f": 22.5 },               // 响片落下（= dt6.clickerMs）
      { "t": -15,   "f": 22.1 },               // 撒放关键段（最需 1000Hz）
      { "t": -5,    "f": 20.3 },               // 松手瞬间
      { "t": 0,     "f": 14.2 },               // 离弦·力骤降（= releaseTime）
      { "t": 15,    "f": 0.2 },
      { "t": 20,    "f": 0.0 },                // 弓弦回位
      { "t": 500,   "f": 0.0 }                 // 峰后
    ],
    "peak": { "value": 22.6, "timeMs": -490, "phase": "full-draw", "unit": "kg" },
    "stability": 0.994,                        // 1 - 满弓段变异系数（0-1，越接近1越稳）
    "drawDurationMs": 3580
  }
}

// ---- dataType=6 撒放时序（MCRT，事件级，事后聚合）----
{
  "schemaVersion": "1.1",
  "messageId": "msg_1963169497552654_0002",
  "sentAt": "2025-09-09T10:18:45.900Z",
  "dataType": 6,
  "data": {
    "releaseTime": "2025-09-09T10:18:44.620Z",
    "shotSeq": 1,
    "shotId": "1963169497552654336",
    "clickerMs": -180,      // 响片触发（相对离弦，负=击发前）
    "mcrtMs": 180,          // MCRT = 0 - clickerMs = 180（核心过程指标）
    "holdMs": 40            // 撒放后随势保持时长
  }
}

// ---- 自洽校验（与 dt5 对应）----
// clickerMs(-180) ↔ dt5 曲线上 f=22.5 的 t=-180 点
// mcrtMs(180) ↔ dt5 力曲线骤降拐点反算（可 Bland-Altman 对账）
// releaseTime ↔ dt5 中 f 骤降的 t=0 点
